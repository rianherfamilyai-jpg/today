#!/usr/bin/env bash
# pre-push hook.
#
#   * Blocks pushes to main/master from ANY remote (belt to the server-side
#     branch ruleset's braces — you should open a PR and merge, never push
#     to the trunk directly).
#   * Runs the full local no-mistakes gate when you push to the `no-mistakes`
#     remote. `git push origin …` stays on the fast path (ungated escape
#     hatch — CI is still the backstop); `git push no-mistakes …` is the
#     deliberate quality push from the runbook.
#
# Wired in via `core.hooksPath=.githooks` (set by scripts/setup-hooks.sh,
# which the package.json "prepare" script runs on `npm install`).

set -euo pipefail

REMOTE_NAME="${1:-}"
REPO_ROOT="$(git rev-parse --show-toplevel)"
ZERO="0000000000000000000000000000000000000000"

# stdin: <local-ref> <local-sha> <remote-ref> <remote-sha>  (one line per ref)
blocked=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue   # ref deletion: nothing to gate
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      echo "pre-push: refusing to push to '$remote_ref' — open a PR and merge instead." >&2
      blocked=1
      ;;
  esac
done

if [ "$blocked" -eq 1 ]; then
  exit 1
fi

# Only the `no-mistakes` remote triggers the local gate.
if [ "$REMOTE_NAME" = "no-mistakes" ]; then
  bash "$REPO_ROOT/scripts/no-mistakes.sh" HEAD
fi

exit 0
